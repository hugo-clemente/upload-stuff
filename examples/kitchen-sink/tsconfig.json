{
  "compilerOptions": {
    "target": "ESNext",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      "@/*": [
        "./*"
      ],
      "@upload-stuff/core": [
        "../../packages/core/src/index.ts"
      ],
      "@upload-stuff/server": [
        "../../packages/server/src/index.ts"
      ],
      "@upload-stuff/server/next": [
        "../../packages/server/src/next/index.ts"
      ],
      "@upload-stuff/server/adapters/s3": [
        "../../packages/server/src/adapters/s3.ts"
      ],
      "@upload-stuff/server/adapters/prisma": [
        "../../packages/server/src/adapters/prisma.ts"
      ],
      "@upload-stuff/client": [
        "../../packages/client/src/index.ts"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ],
    "esModuleInterop": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
