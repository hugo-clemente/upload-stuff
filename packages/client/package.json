{
  "name": "@upload-stuff/client",
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "description": "React hooks and helpers for upload-stuff.",
  "keywords": ["upload", "file-upload", "react", "swr", "hooks"],
  "repository": { "type": "git", "url": "https://github.com/hugoclemente/upload-stuff", "directory": "packages/client" },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }
  },
  "files": ["dist"],
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "check-types": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@upload-stuff/core": "workspace:*",
    "browser-image-compression": "^2.0.2",
    "hono": "^4.10.7",
    "swr": "^2.3.7",
    "ts-pattern": "5.9.0",
    "type-fest": "^4.41.0"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@upload-stuff/server": "workspace:*",
    "tsup": "^8.3.5",
    "typescript": "5.9.3"
  }
}
