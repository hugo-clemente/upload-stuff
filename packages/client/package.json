{
  "name": "@upload-stuff/client",
  "version": "0.0.0",
  "description": "React hooks and helpers for upload-stuff.",
  "keywords": [
    "file-upload",
    "hooks",
    "react",
    "swr",
    "upload"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hugo-clemente/upload-stuff",
    "directory": "packages/client"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "check-types": "tsc --noEmit",
    "lint": "vp lint ."
  },
  "dependencies": {
    "@upload-stuff/core": "workspace:*",
    "browser-image-compression": "^2.0.2",
    "hono": "^4.10.7",
    "swr": "^2.3.7",
    "ts-pattern": "5.9.0",
    "type-fest": "^4.41.0"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@upload-stuff/server": "workspace:*",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "react": ">=19"
  }
}
