{
  "name": "@upload-stuff/client",
  "version": "0.2.0",
  "description": "Framework-free upload engine for upload-stuff.",
  "keywords": [
    "file-upload",
    "upload",
    "s3",
    "presigned-url"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hugo-clemente/upload-stuff",
    "directory": "packages/client"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "check-types": "tsc --noEmit",
    "lint": "vp lint ."
  },
  "dependencies": {
    "@upload-stuff/core": "workspace:*",
    "browser-image-compression": "^2.0.2",
    "ts-pattern": "5.9.0"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
