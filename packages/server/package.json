{
  "name": "@upload-stuff/server",
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "description": "Server runtime, Next.js handler and S3/Prisma adapters for upload-stuff.",
  "keywords": ["upload", "file-upload", "s3", "hono", "nextjs", "prisma"],
  "repository": { "type": "git", "url": "https://github.com/hugoclemente/upload-stuff", "directory": "packages/server" },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./next": { "types": "./dist/next/index.d.ts", "import": "./dist/next.js" },
    "./adapters/s3": { "types": "./dist/adapters/s3.d.ts", "import": "./dist/adapters/s3.js" },
    "./adapters/prisma": { "types": "./dist/adapters/prisma.d.ts", "import": "./dist/adapters/prisma.js" }
  },
  "files": ["dist"],
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "check-types": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.896.0",
    "@aws-sdk/s3-request-presigner": "^3.896.0",
    "@hono/zod-validator": "^0.7.5",
    "@paralleldrive/cuid2": "^2.2.2",
    "@upload-stuff/core": "workspace:*",
    "date-fns": "^4.1.0",
    "hono": "^4.10.7",
    "zod": "4.1.11"
  },
  "peerDependencies": {
    "@prisma/client": ">=5.16"
  },
  "peerDependenciesMeta": {
    "@prisma/client": { "optional": true }
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "5.9.3",
    "vitest": "^4.0.18"
  }
}
