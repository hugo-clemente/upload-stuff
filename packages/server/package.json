{
  "name": "@upload-stuff/server",
  "version": "0.1.0",
  "description": "Server runtime, Next.js handler and S3/Prisma adapters for upload-stuff.",
  "keywords": [
    "file-upload",
    "hono",
    "nextjs",
    "prisma",
    "s3",
    "upload"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hugo-clemente/upload-stuff",
    "directory": "packages/server"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./next": {
      "types": "./dist/next/index.d.ts",
      "import": "./dist/next.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./adapters/s3": {
      "types": "./dist/adapters/s3.d.ts",
      "import": "./dist/adapters/s3.js"
    },
    "./adapters/prisma": {
      "types": "./dist/adapters/prisma.d.ts",
      "import": "./dist/adapters/prisma.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "check-types": "tsc --noEmit",
    "lint": "vp lint ."
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.5",
    "@paralleldrive/cuid2": "^2.2.2",
    "@upload-stuff/core": "workspace:*",
    "hono": "^4.10.7",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.896.0",
    "@aws-sdk/s3-request-presigner": "^3.896.0",
    "@types/node": "^25.9.2",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": ">=3.700.0",
    "@aws-sdk/s3-request-presigner": ">=3.700.0",
    "@prisma/client": ">=5.16"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-s3": {
      "optional": true
    },
    "@aws-sdk/s3-request-presigner": {
      "optional": true
    },
    "@prisma/client": {
      "optional": true
    }
  }
}
