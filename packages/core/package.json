{
  "name": "@upload-stuff/core",
  "version": "0.0.0",
  "description": "Shared isomorphic types, Zod schemas and errors for upload-stuff.",
  "keywords": [
    "file-upload",
    "nextjs",
    "react",
    "s3",
    "upload",
    "zod"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hugoclemente/upload-stuff",
    "directory": "packages/core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "check-types": "tsc --noEmit",
    "lint": "vp lint ."
  },
  "dependencies": {
    "@standard-schema/spec": "^1.0.0",
    "type-fest": "^4.41.0",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
